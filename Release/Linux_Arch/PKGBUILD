# Create tarball:
# tar -czf ./Release/tools-cpp.tar.gz Tools Tools.hpp
#
# Install using selected environment
# pacman -U <packagename>

pkgname=${MINGW_PACKAGE_PREFIX:tools-cpp}tools-cpp
pkgdesc="Personal header-only C++ utility library"
pkgver=14042026
pkgrel=1
arch=('any')

license=('MIT')
# depends=("${MINGW_PACKAGE_PREFIX}-fmt")
source=("tools-cpp.tar.gz")
sha256sums=('SKIP')

package() {
  install -d "${pkgdir}${MINGW_PREFIX}/include"

  install -m644 "${srcdir}/Tools.hpp" \
                "${pkgdir}${MINGW_PREFIX}/include/Tools.hpp"

  cp -r "${srcdir}/Tools" \
        "${pkgdir}${MINGW_PREFIX}/include/"
}

package() {
    install -d "$pkgdir/usr/include/Tools"

    cp -r "$srcdir/Tools/"* \
          "$pkgdir/usr/include/Tools/"
}
